FROM python:3.12-slim AS build
WORKDIR /src
COPY pyproject.toml ./
COPY peakguard ./peakguard
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim
COPY --from=build /install /usr/local
RUN useradd --system --uid 10001 --no-create-home peakguard
USER peakguard
EXPOSE 8000
CMD ["uvicorn", "peakguard.api:app", "--host", "0.0.0.0", "--port", "8000"]
