# Valores definidos pelo operador; a aplicação não carrega este arquivo automaticamente.
OPENAI_API_KEY=
PEAKGUARD_LLM_MODEL=
PEAKGUARD_LLM_ENABLED=

# Modo local (padrão): aceita somente conexões loopback.
# Modo token: exige Bearer em todas as rotas; configure TLS no proxy externo.
PEAKGUARD_AUTH_MODE=local
PEAKGUARD_API_TOKEN=
# Somente quando backend em modo token e dashboard continuar local:
PEAKGUARD_BACKEND_TOKEN=
